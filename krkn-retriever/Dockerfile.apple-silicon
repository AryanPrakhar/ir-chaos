FROM registry.fedoraproject.org/fedora:42

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

ARG GGML_BACKEND=vulkan
ARG TORCH_BUILD=auto
ARG TORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu126

RUN dnf -y install --setopt=install_weak_deps=False \
      python3 python3-pip python3-devel \
      gcc gcc-c++ cmake ninja-build make pkgconf-pkg-config \
      vulkan-loader vulkan-loader-devel vulkan-headers \
      spirv-headers-devel \
      spirv-tools && \
    dnf clean all

# Install mesa without nvidia junk
RUN dnf -y install --setopt=install_weak_deps=False \
      --exclude="mesa-vulkan-drivers-*nvidia*" \
      --exclude="nvidia-*" \
      --exclude="xorg-x11-drv-nvidia*" \
      mesa-vulkan-drivers && \
    dnf clean all

# Install glslc from Vulkan SDK (1.3.x) which does NOT advertise coopmat2 on ARM,
# replacing Fedora's too-new glslc that triggers the broken shader paths.
# We wrap it so llama.cpp cmake finds it at /usr/bin/glslc as usual.
RUN dnf -y install --setopt=install_weak_deps=False python3-pip wget && \
    pip install glslc-python 2>/dev/null || true && \
    # Fallback: just pin glslc via the Fedora glslang package which ships an older binary
    dnf -y install --setopt=install_weak_deps=False glslang && \
    dnf clean all

# Wrap glslc to lie about coopmat2 support — the shader-caps probe works by
# running glslc on a tiny test shader; we intercept and return failure for those.
RUN printf '#!/bin/bash\n\
ARGS="$@"\n\
# If this looks like a capability probe for coopmat/dot/bfloat16, fail it\n\
if echo "$ARGS" | grep -qE "CooperativeMatrix|cooperative_matrix|NV_cooperative_matrix|integer_dot|bfloat16"; then\n\
  exit 1\n\
fi\n\
exec /usr/bin/glslc.real "$@"\n' > /usr/local/bin/glslc && \
    chmod +x /usr/local/bin/glslc && \
    # Save real glslc
    cp /usr/bin/glslc /usr/bin/glslc.real && \
    # Make our wrapper take priority
    ln -sf /usr/local/bin/glslc /usr/bin/glslc

RUN pip install --upgrade pip setuptools wheel && \
    CMAKE_ARGS="-DGGML_VULKAN=on" \
    FORCE_CMAKE=1 \
    CMAKE_BUILD_PARALLEL_LEVEL=2 \
      pip install --no-binary=llama-cpp-python llama-cpp-python && \
    if [ "$TORCH_BUILD" = "cuda" ]; then \
      pip install --index-url "$TORCH_CUDA_INDEX_URL" torch; \
    else \
      pip install --index-url https://download.pytorch.org/whl/cpu torch; \
    fi && \
    pip install \
      fastapi \
      uvicorn \
      transformers==4.52.4 \
      "huggingface_hub[cli]" \
      sentence-transformers \
      faiss-cpu \
      FlagEmbedding==1.2.3 \
      requests

# Remove the wrapper after build — runtime doesn't need it
RUN rm /usr/local/bin/glslc && \
    mv /usr/bin/glslc.real /usr/bin/glslc

COPY krkn-retriever/ /app/
COPY docs/ /app/docs/

ENV GGML_BACKEND_BUILT=vulkan

EXPOSE 8080
CMD ["python3", "api_server.py"]